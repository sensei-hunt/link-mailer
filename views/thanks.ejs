<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t.thankYou %></title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <main class="stage">
    <% if (typeof error !== 'undefined' && error) { %>
      <h1 class="hello" style="opacity:1;animation:none"><%= t.thankYou %></h1>
      <p class="errtext" style="text-align:center"><%= error %></p>
      <a class="btn secondary" href="javascript:history.back()">↩</a>
    <% } else { %>
      <h1 class="hello" style="opacity:1;animation:none"><%= t.thankYou %><%= email ? ', ' + email : '' %></h1>
      <p class="muted"><%= t.submitted %></p>
      <% if (dev) { %>
        <p class="muted small">Dev mode: Telegram isn't configured yet, so the answer was logged
           to the server console instead of the chat.</p>
      <% } %>
    <% } %>
  </main>
</body>
</html>
