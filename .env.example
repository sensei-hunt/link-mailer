# ---- Server ----
PORT=3000
# Public base URL used in the email button link. No trailing slash.
# For real classmates this must be a PUBLIC url (deployed, or an ngrok tunnel).
BASE_URL=http://localhost:3000

# The question classmates answer.
QUESTION=Who is the strongest Avenger?

# Language for all app + email text: en, es, nl, fr, de (add more in i18n.js).
APP_LANG=en
# Timezone for the email's date + deadline. On Railway, add this as a variable.
TZ=America/Mexico_City
# Optional: translate the QUESTION itself per language.
# QUESTION_ES=¿Quién es el Vengador más fuerte?
# QUESTION_NL=Wie is de sterkste Avenger?

# ---- Telegram ----
# Create a bot with @BotFather to get the token; add the bot to your group
# and read the chat id (e.g. via @userinfobot or getUpdates).
# Leave blank to run in DEV mode (answers are logged to the console).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
